# Copy this file to .env to point MonoGame's shader compiler at a wine prefix.
#
# GeonBit.UI compiles its theme effects (Content/GeonBit.UI/themes/*/effects/
# *.fx) with EffectProcessor, which runs mgfxc through wine, so a Linux build
# needs a wine prefix even when no effect source was edited.
#
# MonoGame ships a helper script that installs wine and creates the prefix:
#   wget -qO- https://monogame.net/downloads/net8_mgfxc_wine_setup.sh | bash
#
# Point the variables below at your own prefix. Wine refuses a prefix owned by
# another user, so these paths must not be shared between machines or accounts.
MGFXC_WINE_PATH="$HOME/.wine-mgfxc"
WINEPREFIX="$HOME/.wine-mgfxc"
